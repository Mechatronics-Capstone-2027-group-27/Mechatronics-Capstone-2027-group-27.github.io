---
// date · author · collaborators · hours. Every field is optional so cards and
// detail pages can choose which ones to show; empty collaborators render nothing.
import Icon from './Icon.astro';
import { memberName } from '../config/site';
import { formatDate, formatHours, isoDate, joinNames } from '../lib/format';

interface Props {
  date?: Date;
  author?: string;
  /** Spell out "Logged by <author>" — for a card shown on a collaborator's tab. */
  loggedBy?: boolean;
  collaborators?: readonly string[];
  hours?: number;
  /** Pre-formatted hours (e.g. "2 h each"); takes precedence over `hours`. */
  hoursText?: string;
  hoursLabel?: string;
  class?: string;
}
const { date, author, loggedBy = false, collaborators = [], hours, hoursText, hoursLabel = 'Time committed', class: cls } = Astro.props;
const collabNames = collaborators.map(memberName);
const shownHours = hoursText ?? (hours !== undefined ? formatHours(hours) : undefined);
---
<ul class:list={['meta', cls]} role="list">
  {date && (
    <li class="meta__item meta__date">
      <Icon name="calendar" size={14} />
      <span class="sr-only">Date:</span>
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
    </li>
  )}
  {author && (
    <li class="meta__item meta__author">
      {loggedBy ? <span class="meta__by">Logged by</span> : <span class="sr-only">Author:</span>}
      <span>{memberName(author)}</span>
    </li>
  )}
  {collabNames.length > 0 && (
    <li class="meta__item meta__collab">
      <Icon name="users" size={14} />
      <span>with {joinNames(collabNames)}</span>
    </li>
  )}
  {shownHours !== undefined && (
    <li class="meta__item meta__hours">
      <Icon name="clock" size={14} />
      <span class="sr-only">{hoursLabel}:</span>
      <span>{shownHours}</span>
    </li>
  )}
</ul>
