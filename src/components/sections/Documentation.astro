---
// Lists only the deliverables that have a file. With none, the section is left off
// the page altogether (src/lib/sections.ts) rather than listing things to come.
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { DOCUMENTS } from '../../config/site';

const posted = DOCUMENTS.filter(d => d.href);
---
<Section id="documentation" eyebrow="Deliverables" title="Documentation" deck="Course deliverables, posted as they are produced.">
  <ul class="docs reveal" role="list">
    {posted.map(d => (
      <li class="docs__item">
        <Icon name="file-text" size={20} />
        <a href={d.href}>{d.label}</a>
      </li>
    ))}
  </ul>
</Section>
