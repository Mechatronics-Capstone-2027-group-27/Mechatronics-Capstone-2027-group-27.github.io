---
// The monday.com board embed, carried over from the original index.html (§1.3, §8.8).
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { SITE, TEAM_NUMBER } from '../../config/site';
---
<Section id="monday" eyebrow="Project management" title="Project board" deck="Live task tracking from our monday.com board.">
  <div class="embed reveal">
    <iframe
      src={SITE.mondayEmbedUrl}
      title={`Group ${TEAM_NUMBER} project board`}
      loading="lazy"
      width="770"
      height="500"
    ></iframe>
  </div>
  <p class="embed__fallback">
    <a href={SITE.mondayEmbedUrl} target="_blank" rel="noopener noreferrer">
      Open the board on monday.com <Icon name="external-link" size={14} /><span class="sr-only"> (opens in a new tab)</span>
    </a>
  </p>
</Section>
