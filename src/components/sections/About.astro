---
// Everything here comes from src/config/site.ts and each part is optional: the
// summary, the objectives, the photo and the diagram each appear only once they
// are real. The section itself is left out while it has no text (src/lib/sections.ts).
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import { IMAGES, PROJECT, isSet } from '../../config/site';
import aboutImg from '../../assets/img/about.jpg';
import systemDiagram from '../../assets/img/system-diagram.svg';
---
<Section id="about" eyebrow="Overview" title="About the project" deck={PROJECT.subtitle}>
  <div class:list={['about', { 'about--solo': !IMAGES.about }]}>
    <div class="about__text reveal">
      {isSet(PROJECT.summary) && <p>{PROJECT.summary}</p>}
      {PROJECT.objectives.length > 0 && (
        <>
          <h3 class="about__sub">Key objectives</h3>
          <ul class="about__objectives">
            {PROJECT.objectives.map(o => <li>{o}</li>)}
          </ul>
        </>
      )}
    </div>
    {IMAGES.about && (
      <div class="about__media reveal">
        <Image src={aboutImg} alt="" widths={[600, 900, 1200, 1800]} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
    )}
  </div>
  {IMAGES.systemDiagram && (
    <figure class="diagram reveal">
      <Image src={systemDiagram} alt="System architecture diagram" />
      <figcaption>System architecture</figcaption>
    </figure>
  )}
</Section>
