---
// Email CTA without a raw mailto in the HTML source (§7.5). The address is
// stored base64-encoded and reversed in data-mail; src/scripts/site.ts decodes
// it into a mailto at runtime. With no address set it renders nothing, rather
// than a link that goes nowhere.
import Icon from './Icon.astro';
import { isSet } from '../config/site';

interface Props {
  email: string | null | undefined;
  /** Replace the link text with the address itself once the script has decoded it. */
  showAddress?: boolean;
  class?: string;
}
const { email, showAddress = false, class: cls } = Astro.props;
const encoded = isSet(email) ? Buffer.from(email).toString('base64').split('').reverse().join('') : undefined;
// The floor for visitors with JavaScript off, who never get the decoded link: the
// address spelled out for a person to read ("name [at] example [dot] com"). It is
// still not the literal address, so a simple harvester doesn't pick it up.
const spelledOut = isSet(email) ? email.replace('@', ' [at] ').replaceAll('.', ' [dot] ') : undefined;
---
{encoded && (
  <a class:list={['btn btn--ghost', cls]} href="#reach-out" data-mail={encoded}>
    <span data-mail-label={showAddress ? '' : undefined}><slot /></span>
    <Icon name="mail" size={16} />
  </a>
  <noscript><span class="mail-fallback">{spelledOut}</span></noscript>
)}
