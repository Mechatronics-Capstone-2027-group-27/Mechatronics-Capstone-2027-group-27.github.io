---
// Front page (§8). Sections render in SECTION_ORDER and respect FEATURES —
// reorder or switch off sections in src/config/site.ts, not here. A section that
// is switched on but has nothing real to show is also left out (src/lib/sections.ts).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/sections/About.astro';
import MajorUpdates from '../components/sections/MajorUpdates.astro';
import ReachOut from '../components/sections/ReachOut.astro';
import Timeline from '../components/sections/Timeline.astro';
import Team from '../components/sections/Team.astro';
import Documentation from '../components/sections/Documentation.astro';
import Monday from '../components/sections/Monday.astro';
import { IMAGES } from '../config/site';
import { visibleSections } from '../lib/sections';
import band from '../assets/img/band-1.jpg';

const sections = await visibleSections();
---
<BaseLayout overlayNav>
  {sections.map(s => (
    s === 'hero' ? <Hero /> :
    s === 'about' ? (
      <>
        <About />
        {IMAGES.band && (
          <div class="band" aria-hidden="true">
            <Image src={band} alt="" widths={[1280, 1920, 2560]} sizes="100vw" />
          </div>
        )}
      </>
    ) :
    s === 'major-updates' ? <MajorUpdates /> :
    s === 'reach-out' ? <ReachOut /> :
    s === 'timeline' ? <Timeline /> :
    s === 'team' ? <Team /> :
    s === 'documentation' ? <Documentation /> :
    s === 'monday' ? <Monday /> : null
  ))}
</BaseLayout>
