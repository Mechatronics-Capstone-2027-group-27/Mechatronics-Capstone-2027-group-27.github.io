---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkLogView from '../../components/WorkLogView.astro';
import StatRow from '../../components/StatRow.astro';
import CadenceStrip from '../../components/CadenceStrip.astro';
import { getWorkLog, workLogStats } from '../../lib/entries';
import { formatDate, formatHours } from '../../lib/format';

const entries = await getWorkLog();
const s = workLogStats(entries);
const stats = [
  { label: 'Entries', value: String(s.total) },
  // Every participant's hours added up: a 2 h meeting with 4 people is 8, not 2.
  { label: 'Person-hours', value: formatHours(s.personHours).replace(/ h$/, '') },
  { label: 'Last 14 days', value: String(s.last14) },
  { label: 'Most recent', value: s.latest ? formatDate(s.latest) : '—' },
];
---
<BaseLayout title="Work Log" description="Individual progress log entries from every team member, with dates, collaborators and time committed.">
  <WorkLogView
    current="all"
    title="Work log"
    lede="Every entry from every team member, newest first. Each card shows the date, author, collaborators and time committed. An entry is written once and also appears on each collaborator's tab; person-hours counts every participant's time."
    entries={entries}
  >
    <StatRow stats={stats} />
    <CadenceStrip entries={entries} />
  </WorkLogView>
</BaseLayout>
